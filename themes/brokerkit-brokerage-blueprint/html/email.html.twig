<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif" />
      <mj-text font-size="13px" color="#000000" line-height="100%" />
    </mj-attributes>
    <mj-style inline="inline">
      a {color:#16b783; text-decoration:underline;}
      p {margin:0;}
      h2 {color:#16b783;}
    </mj-style>
  </mj-head>
  <mj-body>
    <mj-section background-color="#16b783" padding="0">
      <mj-column>
        <mj-spacer height="4px" />
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="20px 20px 10px">
      <mj-column>
        <mj-image src="https://marketing.brokerkit.app/media/images/email_banners_-_brokerage_blueprint_series.png" alt="Brokerage Blueprint Series" width="510px" align="center" />
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="20px">
      <mj-column>
        <mj-text font-size="12px" color="#16b783" font-weight="bold" text-transform="uppercase" letter-spacing="1px">
          Brokerage Blueprint Webinar
        </mj-text>
        <mj-text>
          <p>Your email content goes here.</p>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="10px 20px">
      <mj-column>
        <mj-button background-color="#16b783" color="#ffffff" font-size="16px" font-weight="700" border-radius="3px" inner-padding="12px 25px" href="https://example.com">
          Register Now
        </mj-button>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="0 20px">
      <mj-column>
        <mj-divider border-color="#16b783" border-width="2px" padding="10px 0" />
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="10px 20px">
      <mj-column>
        <mj-image src="https://marketing.brokerkit.app/media/images/email_banners.png" alt="BrokerKit" width="510px" align="center" />
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="0 20px">
      <mj-column>
        <mj-divider border-color="#16b783" border-width="2px" padding="10px 0" />
      </mj-column>
    </mj-section>
    <mj-section padding="20px 0 0">
      <mj-column>
        <mj-text font-size="12px" color="#23496d" align="center">
          <p>Brokerkit, PO BOX 6752, Denver, CO 80206, (720) 741-2157</p>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="10px 0 20px">
      <mj-column>
        <mj-text font-size="11px" color="#6d6d6d" align="center">
          <p>{unsubscribe_text} | {webview_text}</p>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
